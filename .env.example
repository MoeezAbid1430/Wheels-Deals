REACT_APP_API_URL=http://localhost:4000/api
REACT_APP_REALTIME_URL=http://localhost:4000/api/realtime
REACT_APP_REALTIME_WS_URL=ws://localhost:4000/api/realtime/ws

# API server
PORT=4000
JWT_SECRET=change-me-before-production
JWT_ISSUER=wheels-deals-api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
STORAGE_DRIVER=json
DATA_FILE=./data/dev-db.json

# Production target, used after PostgreSQL repositories are implemented.
DATABASE_URL=postgres://user:password@localhost:5432/wheels_deals
DATABASE_SSL=false

# Optional. Used by /api/integrations/maps/places for live Google Places results.
# If missing, the API falls back to the verified local repair shop directory.
GOOGLE_MAPS_API_KEY=

# Dedicated search engine. Use memory/postgres for local fallback,
# or meilisearch/elasticsearch with SEARCH_URL for production index service.
SEARCH_PROVIDER=memory
SEARCH_URL=
SEARCH_API_KEY=
SEARCH_LISTINGS_INDEX=wheels_deals_listings

# Media storage. Local mode writes bytes to LOCAL_MEDIA_DIR.
MEDIA_PROVIDER=local
LOCAL_MEDIA_DIR=./data/media
MAX_MEDIA_UPLOAD_BYTES=104857600
MEDIA_CDN_BASE_URL=
MEDIA_SCAN_PROVIDER=none
IMAGE_PROCESSOR=none
VIDEO_PROCESSOR=none
