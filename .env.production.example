NODE_ENV=production
PORT=4000
CORS_ORIGINS=https://your-domain.com
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=wheels-deals-api

STORAGE_DRIVER=postgres
DATABASE_URL=postgres://wheels_deals:wheels_deals_dev_password@localhost:5432/wheels_deals
DATABASE_SSL=false

PAYMENT_PROVIDER=bank
BANK_GATEWAY_BASE_URL=
BANK_GATEWAY_API_KEY=
BANK_GATEWAY_WEBHOOK_SECRET=

GOOGLE_MAPS_API_KEY=

MEDIA_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_SIGNED_URL_EXPIRES_SECONDS=900
MEDIA_CDN_BASE_URL=https://cdn.your-domain.com
MAX_MEDIA_UPLOAD_BYTES=104857600
MEDIA_SCAN_PROVIDER=clamav
IMAGE_PROCESSOR=sharp-worker
VIDEO_PROCESSOR=ffmpeg-worker

SEARCH_PROVIDER=meilisearch
SEARCH_URL=http://localhost:7700
SEARCH_API_KEY=replace-with-search-master-key
SEARCH_LISTINGS_INDEX=wheels_deals_listings
RECOMMENDER_PROVIDER=local-hybrid
