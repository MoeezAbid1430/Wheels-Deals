OPENAI_EMBEDDING_MODEL=text-embedding-3-large
CHATBOT_BACKEND_BASE_URL=http://localhost:4000/api
CHATBOT_PUBLIC_BASE_URL=http://localhost:4100
CHATBOT_SYSTEM_NAME=Wheels&Deals Copilot
CHATBOT_ENABLE_RAG=true
CHATBOT_ENABLE_LIVE_TOOLS=true
